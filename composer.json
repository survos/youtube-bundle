{
    "name": "survos/youtube-bundle",
    "description": "YouTube channel fetching and resumable uploads for Symfony, powered by Google's official PHP client",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["symfony", "youtube", "upload", "oauth"],
    "require": {
        "php": "^8.5",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "google/apiclient": "^2.19.4",
        "survos/kit-bundle": "^2.28",
        "symfony/config": "^8.1",
        "symfony/console": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/filesystem": "^8.1",
        "symfony/http-kernel": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "phpstan/phpstan": "^2.0",
        "symfony/framework-bundle": "^8.1"
    },
    "autoload": {"psr-4": {"Survos\\YoutubeBundle\\": "src/"}},
    "autoload-dev": {"psr-4": {"Survos\\YoutubeBundle\\Tests\\": "tests/"}},
    "scripts": {"test": "phpunit", "analyse": "phpstan analyse --memory-limit=512M"}
}
